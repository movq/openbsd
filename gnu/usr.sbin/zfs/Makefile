SUBDIR+=libnvpair
SUBDIR+=libuutil
SUBDIR+=libzutil
SUBDIR+=libzfs_core
SUBDIR+=libshare
SUBDIR+=libzfs
SUBDIR+=zpool
SUBDIR+=zfs
SUBDIR+=zinject
SUBDIR+=zfs_ids_to_path

.include <bsd.obj.mk>
